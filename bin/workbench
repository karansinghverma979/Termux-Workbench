#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# ⚡ Termux-Workbench Management Engine (workbench)
# Author: Karan Singh Verma & Repo-Architect
# ==============================================================================

set -e

WORKBENCH_ROOT="${WORKBENCH_ROOT:-"${HOME}/.termux-workbench"}"
if [ ! -d "$WORKBENCH_ROOT" ]; then
    # Fallback if installed in current script directory
    WORKBENCH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

PROFILE_STATE_FILE="${HOME}/.config/workbench_active_profile"
[ ! -f "$PROFILE_STATE_FILE" ] && mkdir -p "${HOME}/.config" && echo "dev" > "$PROFILE_STATE_FILE"

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
MAGENTA='\033[1;35m'
BOLD='\033[1m'
NC='\033[0m'

show_help() {
    cat << 'EOF'
 ┌─────────────────────────────────────────────────────────────┐
 │           ⚡ TERMUX-WORKBENCH CONTROL ENGINE                │
 └─────────────────────────────────────────────────────────────┘
Usage:
   workbench status             # Display active profile, prompt & peer telemetry
   workbench profile            # Interactive FZF profile switcher (dev, vim, sysadmin)
   workbench profile <name>     # Switch active profile directly
   workbench theme              # Interactive prompt theme switcher
   workbench font               # Interactive FZF font switcher (Nerd Fonts)
   workbench font <name>        # Switch active terminal font directly
   workbench ssh                # Show SSH daemon status, IP, port & pairing info
   workbench pkg [install|check]# Manage & install essential packages (Python, ifconfig, iwconfig, etc.)
   workbench update             # Pull latest updates from GitHub and reload
   workbench backup             # Create a timestamped configuration backup
   workbench restore [file]     # Rollback from a backup archive
   workbench help               # Show this manual
EOF
}

cmd_status() {
    local cur_profile=$(cat "$PROFILE_STATE_FILE" 2>/dev/null || echo "dev")
    local cur_theme=$(cat "${HOME}/.config/starship_current_theme.txt" 2>/dev/null || echo "default")
    local cur_font=$(cat "${HOME}/.termux_current_font.txt" 2>/dev/null || echo "JetBrainsMonoNF-Bold")

    echo -e "${CYAN}${BOLD}⚡ Termux-Workbench Runtime Status${NC}"
    echo -e "  • ${BOLD}Active Profile:${NC} ${GREEN}${cur_profile}${NC}"
    echo -e "  • ${BOLD}Prompt Engine:${NC}  ${MAGENTA}Starship${NC} (${cur_theme})"
    echo -e "  • ${BOLD}Nerd Font:${NC}      ${CYAN}${cur_font}${NC}"
    echo -e "  • ${BOLD}Workbench Path:${NC} ${WORKBENCH_ROOT}"
    if [ -f "${HOME}/.peer_pc.env" ]; then
        echo -e "  • ${BOLD}Peer Config:${NC}    ${YELLOW}~/.peer_pc.env (Active)${NC}"
    else
        echo -e "  • ${BOLD}Peer Config:${NC}    ${RED}Unconfigured (~/.peer_pc.env missing)${NC}"
    fi
}

cmd_profile() {
    local target="$1"
    local profiles_dir="${WORKBENCH_ROOT}/profiles"

    if [ -z "$target" ]; then
        if command -v fzf >/dev/null 2>&1; then
            local available=($(ls -d "${profiles_dir}"/*/ 2>/dev/null | xargs -n 1 basename))
            target=$(printf '%s\n' "${available[@]}" | fzf --prompt="Select Workbench Profile > " --height=40% --reverse)
        else
            echo -e "${YELLOW}Available profiles:${NC} $(ls -d "${profiles_dir}"/*/ | xargs -n 1 basename)"
            echo -e "Usage: workbench profile <name>"
            return 0
        fi
    fi

    if [ -n "$target" ]; then
        local target_config="${profiles_dir}/${target}/termux.properties"
        if [ -f "$target_config" ]; then
            cp -f "$target_config" "${HOME}/.termux/termux.properties"
            echo "$target" > "$PROFILE_STATE_FILE"
            if command -v termux-reload-settings >/dev/null 2>&1; then
                termux-reload-settings
            fi
            echo -e "${GREEN}✨ Successfully switched to profile:${NC} ${BOLD}${target}${NC} (Settings reloaded)"
        else
            echo -e "${RED}❌ Error: Profile '${target}' not found in ${profiles_dir}.${NC}"
            return 1
        fi
    fi
}

cmd_font() {
    local target="$1"
    local fonts_dir="${HOME}/.termux/fonts"
    if [ ! -d "$fonts_dir" ]; then
        echo -e "${RED}❌ Fonts directory ${fonts_dir} not found.${NC}"
        return 1
    fi
    local available=($(ls "$fonts_dir" 2>/dev/null | grep -E '\.(ttf|otf)$' | sed 's/\.[^.]*$//'))
    if [ -z "$target" ]; then
        if command -v fzf >/dev/null 2>&1; then
            target=$(printf '%s\n' "reset (stock font)" "${available[@]}" | fzf --prompt="Select Termux Font > " --height=40% --reverse)
            [ "$target" = "reset (stock font)" ] && target="reset"
        else
            echo -e "${YELLOW}Available Fonts:${NC} reset, ${available[*]}"
            echo -e "Usage: workbench font <name|reset>"
            return 0
        fi
    fi

    if [ "$target" = "reset" ] || [ "$target" = "none" ] || [ "$target" = "stock" ]; then
        rm -f "${HOME}/.termux/font.ttf"
        echo "Stock System Font" > "${HOME}/.termux_current_font.txt"
        if command -v starship >/dev/null 2>&1; then
            starship preset no-nerd-font -o "${HOME}/.config/starship.toml" --force 2>/dev/null || true
            echo "no-nerd-font" > "${HOME}/.config/starship_current_theme.txt"
        fi
        if command -v termux-reload-settings >/dev/null 2>&1; then
            termux-reload-settings
        fi
        echo -e "${GREEN}✨ Reset to Stock System Font (Starship switched to 'no-nerd-font' to prevent broken icons).${NC}"
        return 0
    fi

    if [ -n "$target" ]; then
        local font_file=""
        if [ -f "${fonts_dir}/${target}.ttf" ]; then
            font_file="${fonts_dir}/${target}.ttf"
        elif [ -f "${fonts_dir}/${target}.otf" ]; then
            font_file="${fonts_dir}/${target}.otf"
        elif [ -f "${fonts_dir}/${target}" ]; then
            font_file="${fonts_dir}/${target}"
        fi

        if [ -n "$font_file" ] && [ -f "$font_file" ]; then
            cp -f "$font_file" "${HOME}/.termux/font.ttf"
            echo "$target" > "${HOME}/.termux_current_font.txt"
            if command -v termux-reload-settings >/dev/null 2>&1; then
                termux-reload-settings
            fi
            echo -e "${GREEN}✨ Termux font switched to:${NC} ${BOLD}${target}${NC} (Settings reloaded)"
        else
            echo -e "${RED}❌ Error: Font '${target}' not found in ${fonts_dir}.${NC}"
            return 1
        fi
    fi
}

cmd_update() {
    echo -e "${CYAN}🔄 Checking for updates in ${WORKBENCH_ROOT}...${NC}"
    if [ -d "${WORKBENCH_ROOT}/.git" ]; then
        git -C "${WORKBENCH_ROOT}" pull
        echo -e "${GREEN}✅ Up to date! Reloading current profile...${NC}"
        local cur_profile=$(cat "$PROFILE_STATE_FILE" 2>/dev/null || echo "dev")
        cmd_profile "$cur_profile"
    else
        echo -e "${YELLOW}⚠️ Workbench directory is not a git repository.${NC}"
    fi
}

cmd_pkg() {
    local action="${1:-install}"
    local pkg_script="${WORKBENCH_ROOT}/scripts/pkg-essentials.sh"
    if [ -f "$pkg_script" ]; then
        bash "$pkg_script" "$action"
    else
        echo -e "${RED}❌ Error: Essential package provisioner not found at ${pkg_script}.${NC}"
        return 1
    fi
}

cmd_ssh() {
    local sshd_pid=$(pgrep -x sshd 2>/dev/null || echo "")
    local phone_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
    if [ -z "$phone_ip" ]; then
        phone_ip=$(ifconfig 2>/dev/null | grep -oE "inet [0-9.]+" | grep -v "127.0.0.1" | awk '{print $2}' | head -n1)
    fi
    [[ -z "$phone_ip" ]] && phone_ip="127.0.0.1"
    local termux_user=$(whoami)
    local auth_count=0
    [ -f "${HOME}/.ssh/authorized_keys" ] && auth_count=$(grep -c "^ssh-" "${HOME}/.ssh/authorized_keys" 2>/dev/null || echo 0)
    local active_sessions=$(pgrep -f sshd-session 2>/dev/null | wc -l)

    echo -e "${CYAN}${BOLD}🔒 Termux SSH & Workstation Bridge Status${NC}"
    if [ -n "$sshd_pid" ]; then
        echo -e "  • ${BOLD}SSHD Status:${NC}       ${GREEN}Running (PID: ${sshd_pid}, Port: 8022)${NC}"
    else
        echo -e "  • ${BOLD}SSHD Status:${NC}       ${RED}Stopped${NC} (Run 'sshd' to start)"
    fi
    echo -e "  • ${BOLD}Device IP:${NC}         ${YELLOW}${phone_ip}:8022${NC}"
    echo -e "  • ${BOLD}Termux User:${NC}       ${CYAN}${termux_user}${NC}"
    echo -e "  • ${BOLD}Active Sessions:${NC}   ${MAGENTA}${active_sessions}${NC}"
    echo -e "  • ${BOLD}Authorized Keys:${NC}   ${GREEN}${auth_count} key(s) installed (~/.ssh/authorized_keys)${NC}"
    if [ -f "${HOME}/.peer_pc.env" ]; then
        echo -e "  • ${BOLD}Peer Workstation:${NC}  ${GREEN}Configured (~/.peer_pc.env)${NC}"
    fi
    echo -e "\n${CYAN}🔗 Connect from Motobook Windows Terminal:${NC}"
    echo -e "   ${BOLD}${GREEN}ssh -p 8022 ${termux_user}@${phone_ip}${NC} (or run '${YELLOW}blaze${NC}' in PowerShell)\n"
}

case "$1" in
    status)
        cmd_status
        ;;
    ssh|sshd)
        cmd_ssh
        ;;
    profile)
        cmd_profile "$2"
        ;;
    theme)
        if command -v chship >/dev/null 2>&1; then
            chship
        else
            echo -e "${YELLOW}Run within an interactive Zsh session to switch themes.${NC}"
        fi
        ;;
    font)
        cmd_font "$2"
        ;;
    pkg|pkg-install|packages)
        cmd_pkg "$2"
        ;;
    update)
        cmd_update
        ;;
    backup)
        "${WORKBENCH_ROOT}/scripts/backup.sh"
        ;;
    restore)
        "${WORKBENCH_ROOT}/scripts/restore.sh" "$2"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        show_help
        exit 1
        ;;
esac
