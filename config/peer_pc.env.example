# =========================================================
# 💻 Termux-Matrix: Peer Workstation Environment Template
# =========================================================
# Copy this file to ~/.peer_pc.env to pair Termux with your PC:
#   cp config/peer_pc.env.example ~/.peer_pc.env
#   chmod 600 ~/.peer_pc.env

# 1. Device & Peer Identification
DEVICE_NAME="Termux-Node"
PEER_PC_NAME="Workstation"

# 2. Workstation SSH Credentials
PEER_PC_USER="user"
PEER_PC_PORT="22"

# 3. Static/Fallback IP (Used if hotspot gateway auto-discovery fails)
PEER_PC_IP_OVERRIDE=""

# 4. Workstation Public SSH Key (Automatically appended to ~/.ssh/authorized_keys)
# Example: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@workstation
PEER_PC_PUBKEY=""
